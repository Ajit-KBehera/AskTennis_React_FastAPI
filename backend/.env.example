# Backend env — copy to backend/.env and fill in values.
# Paths are relative to the backend app; main.py loads dotenv from cwd when you run from repo root.

# -----------------------------------------------------------------------------
# Required (If GCP_PROJECT_ID is set, GOOGLE_API_KEY becomes optional/ignored)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=

# Vertex AI Settings (If GCP_PROJECT_ID is set, requests are routed to Vertex AI using Application Default Credentials)
# GCP_PROJECT_ID=
# GCP_LOCATION=us-central1
ENVIRONMENT=development
# openssl rand -hex 32
JWT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Database — use SQLite OR Cloud SQL (not both)
#
# SQLite (default): leave INSTANCE_CONNECTION_NAME unset and either omit DB_TYPE
# or set DB_TYPE=sqlite.
#
# Cloud SQL (Postgres): set DB_TYPE=cloudsql, INSTANCE_CONNECTION_NAME, and all
# TENNIS_* / AUTH_* vars below. Local auth: gcloud auth application-default login
# or GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# -----------------------------------------------------------------------------
DB_TYPE=sqlite

# --- SQLite mode ---
DB_FILE_NAME=tennis_data_with_mcp.db
AUTH_DB_FILE_NAME=asktennis_auth.db

# --- Cloud SQL mode (uncomment and set; comment out SQLite filenames above if you prefer) ---
# DB_TYPE=cloudsql
# INSTANCE_CONNECTION_NAME=project-id:region:instance-name
# TENNIS_DB_NAME=tennis_data_with_mcp
# TENNIS_DB_USER=
# TENNIS_DB_PASSWORD=
# AUTH_DB_NAME=asktennis_auth
# AUTH_DB_USER=
# AUTH_DB_PASSWORD=
# GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Optional services
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# LangChain / provider model id (override as needed)
DEFAULT_MODEL=openai/gpt-4o-mini
# Disables OTel export when set (common in local dev)
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# CORS (production)
# -----------------------------------------------------------------------------
# ALLOW_ALL_ORIGINS=false
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Rate limits (requests per minute)
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
QUERY_RATE_LIMIT_PER_MINUTE=10

# -----------------------------------------------------------------------------
# LangGraph checkpointer
# -----------------------------------------------------------------------------
LANGGRAPH_CHECKPOINTER=sqlite
# LANGGRAPH_CHECKPOINT_DB=sqlite:////absolute/path/to/langgraph_checkpoints.sqlite

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
QUERY_TIMEOUT_SECONDS=300
# Override auth sqlite path when not using Cloud SQL for auth:
# AUTH_DB_PATH=sqlite:////absolute/path/to/asktennis_auth.db
