# Frontend auto-detects the backend at http://localhost:8000 for local development.
# Only set VITE_API_URL if your backend runs on a different address.
# In production (Cloud Run) this variable is injected at Docker build time
# via --build-arg VITE_API_URL=<BACKEND_URL>/api.
# VITE_API_URL=http://localhost:8000/api
